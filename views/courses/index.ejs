<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses - Student Management System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <a href="/" class="brand">🎓 Student Management System</a>
        <div>
            <% if (user) { %>
                <a href="/students">Students</a>
                <a href="/courses">Courses</a>
                <a href="/auth/logout">Logout (<%= user.username %>)</a>
            <% } else { %>
                <a href="/auth/login">Login</a>
            <% } %>
        </div>
    </nav>

    <!-- Container -->
    <div class="container">
        <div class="card">
            <!-- Page Header -->
            <div class="page-header">
                <h1>📚 All Courses</h1>
                <a href="/courses/add" class="btn btn-success">+ Add New Course</a>
            </div>

            <!-- Flash Messages -->
            <% if (success_msg) { %>
                <div class="alert alert-success"><%= success_msg %></div>
            <% } %>
            <% if (error_msg) { %>
                <div class="alert alert-danger"><%= error_msg %></div>
            <% } %>

            <!-- Courses Table -->
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Course Name</th>
                        <th>Code</th>
                        <th>Credits</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (courses.length > 0) { %>
                        <% courses.forEach(course => { %>
                            <tr>
                                <td><%= course.id %></td>
                                <td><%= course.name %></td>
                                <td><%= course.code %></td>
                                <td><%= course.credits %></td>
                                <td><%= course.description %></td>
                                <td>
                                    <a href="/courses/edit/<%= course.id %>" class="btn btn-warning">Edit</a>
                                    <form action="/courses/delete/<%= course.id %>?_method=DELETE" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center;">No courses found. Add one!</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>